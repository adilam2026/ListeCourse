# Copiez ce fichier en ".env" et renseignez les valeurs de votre projet Supabase
# (Project Settings → API). Ces variables sont exposées au client (EXPO_PUBLIC_*),
# ne mettez jamais la clé "service_role" ici — uniquement la clé "anon".

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
